+      tn::ConstByteSpan(), tn::ConstByteSpan(plaintext.data(), plaintext.size()),
+      tn::ByteSpan(buffer.data(), buffer.size())).ok()) return 16;
+  buffer.back() ^= 1;
+  if (backend.Aes256GcmOpen(tn::ConstByteSpan(key), tn::ConstByteSpan(nonce),
+      tn::ConstByteSpan(), tn::ConstByteSpan(buffer.data(), buffer.size()),
+      tn::ByteSpan(buffer.data(), plaintext.size())).ok()) return 17;
+  for (size_t i = 0; i < plaintext.size(); ++i) if (buffer[i]) return 18;
   return 0;
 }
 
