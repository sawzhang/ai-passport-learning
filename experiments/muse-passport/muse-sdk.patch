 USB = {
+    "passport": USJ,
     "s3": USJ,
     "s3n": USJ,
     "aipi": USJ,
@@ -47,7 +48,7 @@ USB = {
 }
 # Boards whose console takes Muse's serial commands (tools/muse/chat.py). The
